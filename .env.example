# Public Supabase config — safe to expose to the browser (same values that
# ship inside the compiled MOKOJI app). See supabase/README.md before the
# site can read real product data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Set to "true" to force the local mock catalogue even if Supabase env vars
# are present (useful for design review before 0076_*.sql has been applied).
NEXT_PUBLIC_USE_MOCK_CATALOG=false

# App download links — leave blank to show "coming soon" instead of a dead
# link. See src/lib/config/site.ts. Host the APK in Supabase Storage, NOT
# under public/ — Cloudflare Workers rejects static assets over 25MB. See
# "APK hosting" in supabase/README.md.
NEXT_PUBLIC_APK_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_APP_RELEASE_DATE=

# Real, verified contact channels only — leave blank rather than invent one.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=

# Site URL, used for canonical/OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://mokoji.example.com
